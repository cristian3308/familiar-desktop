import { Theme } from "theme.slint";

component BarText inherits Text {
    // Only the spacer may grow; everything else keeps its natural width.
    horizontal-stretch: 0;
    color: Theme.text;
    font-size: 13px;
    vertical-alignment: center;
}

component Clickable inherits TouchArea {
    mouse-cursor: pointer;
}

component Battery inherits Rectangle {
    in property <int> percent;
    in property <bool> charging;
    width: 26px;
    height: 12px;
    Rectangle {
        x: 0;
        width: 23px;
        height: parent.height;
        border-radius: 3px;
        border-width: 1px;
        border-color: Theme.text-secondary;
        Rectangle {
            x: 2px;
            y: 2px;
            height: parent.height - 4px;
            width: (parent.width - 4px) * clamp(root.percent, 0, 100) / 100;
            border-radius: 1.5px;
            background: root.charging ? #34c759 : (root.percent <= 20 ? #ff453a : Theme.text);
        }
    }
    Rectangle {
        x: 24px;
        y: 4px;
        width: 2px;
        height: 4px;
        border-radius: 1px;
        background: Theme.text-secondary;
    }
}

export component TopBarWindow inherits Window {
    title: "Familiar Top Bar";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: Theme.font;

    in property <string> app-name: "Escritorio";
    in property <string> clock;
    in property <string> date;
    in property <string> layout-code;
    in property <int> battery: -1;
    in property <bool> charging;
    in property <bool> mic;
    in property <bool> cam;

    callback logo-clicked();
    callback app-clicked();
    callback clock-clicked();
    callback battery-clicked();
    callback layout-clicked();
    callback privacy-clicked();

    Rectangle {
        background: Theme.tint;
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.glow;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 18px;

        // Brand mark: a small diamond.
        Rectangle {
            width: 14px;
            horizontal-stretch: 0;
            Path {
                width: 12px;
                height: 12px;
                y: (parent.height - self.height) / 2;
                fill: Theme.accent;
                viewbox-width: 12;
                viewbox-height: 12;
                commands: "M 6 0 L 12 6 L 6 12 L 0 6 Z";
            }
            Clickable {
                clicked => {
                    root.logo-clicked();
                }
            }
        }
        BarText {
            text: root.app-name;
            font-weight: 700;
            Clickable {
                clicked => {
                    root.app-clicked();
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        if root.mic || root.cam: HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 5px;
            alignment: center;
            if root.cam: Rectangle {
                y: (parent.height - 7px) / 2;
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: #30d158;
            }
            if root.mic: Rectangle {
                y: (parent.height - 7px) / 2;
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: #ff9f0a;
            }
            Clickable {
                clicked => {
                    root.privacy-clicked();
                }
            }
        }
        if root.layout-code != "": BarText {
            text: root.layout-code;
            font-size: 12px;
            font-weight: 600;
            color: Theme.text-secondary;
            Clickable {
                clicked => {
                    root.layout-clicked();
                }
            }
        }
        if root.battery >= 0: HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 6px;
            BarText {
                text: root.battery + "%";
                font-size: 12px;
                color: Theme.text-secondary;
            }
            Battery {
                y: (parent.height - self.height) / 2;
                percent: root.battery;
                charging: root.charging;
            }
            Clickable {
                clicked => {
                    root.battery-clicked();
                }
            }
        }
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 8px;
            BarText {
                text: root.date;
            }
            BarText {
                text: root.clock;
                font-weight: 600;
            }
            Clickable {
                clicked => {
                    root.clock-clicked();
                }
            }
        }
    }
}
