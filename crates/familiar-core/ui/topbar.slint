import { Theme, Label, Dot } from "theme.slint";

component Clickable inherits TouchArea {
    mouse-cursor: pointer;
}

// Hover pill behind a status item, like the macOS menu bar.
component Item inherits Rectangle {
    callback clicked();
    horizontal-stretch: 0;
    border-radius: 6px;
    background: touch.has-hover ? Theme.text.with-alpha(0.10) : transparent;
    animate background { duration: 120ms; }
    touch := Clickable {
        clicked => {
            root.clicked();
        }
    }
    @children
}

// Brand mark: a 3×3 dot grid with a red centre.
component Logo inherits Rectangle {
    width: 13px;
    height: 13px;
    for i in 9: Dot {
        size: 3px;
        x: mod(i, 3) * 5px;
        y: floor(i / 3) * 5px;
        background: i == 4 ? Theme.accent : Theme.text;
    }
}

// Segmented battery gauge in the spirit of Nothing OS.
component Battery inherits Rectangle {
    in property <int> percent;
    in property <bool> charging;
    property <int> lit: ceil(clamp(root.percent, 0, 100) / 12.5);
    property <color> fill: root.percent <= 20 && !root.charging ? Theme.accent : Theme.text;
    width: 8 * 5px - 2px;
    height: 9px;
    for i in 8: Rectangle {
        x: i * 5px;
        width: 3px;
        height: parent.height;
        border-radius: 1px;
        background: i < root.lit ? root.fill : Theme.text.with-alpha(0.18);
    }
}

export component TopBarWindow inherits Window {
    title: "Familiar Top Bar";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: Theme.font;

    in property <string> app-name: "Escritorio";
    in property <string> clock;
    in property <image> clock-dots;
    in property <length> clock-width;
    in property <length> clock-height;
    in property <string> meridiem;
    in property <string> date;
    in property <string> layout-code;
    in property <int> battery: -1;
    in property <bool> charging;
    in property <bool> mic;
    in property <bool> cam;

    callback logo-clicked();
    callback app-clicked();
    callback clock-clicked();
    callback battery-clicked();
    callback layout-clicked();
    callback privacy-clicked();
    callback control-center-clicked();

    // Translucent, like the macOS menu bar: the wallpaper shows through.
    Rectangle {
        background: Theme.bar-tint;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 4px;

        Item {
            width: 30px;
            clicked => {
                root.logo-clicked();
            }
            Logo {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
        Item {
            width: name.preferred-width + 16px;
            clicked => {
                root.app-clicked();
            }
            name := Text {
                x: 8px;
                text: root.app-name;
                font-family: Theme.display;
                font-size: 13px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
                height: parent.height;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        if root.mic || root.cam: Item {
            width: 20px + (root.mic && root.cam ? 10px : 0px);
            clicked => {
                root.privacy-clicked();
            }
            HorizontalLayout {
                alignment: center;
                spacing: 4px;
                if root.cam: Dot {
                    size: 6px;
                    y: (parent.height - 6px) / 2;
                    background: #30d158;
                }
                if root.mic: Dot {
                    size: 6px;
                    y: (parent.height - 6px) / 2;
                    background: Theme.accent;
                }
            }
        }
        if root.layout-code != "": Item {
            width: layout.preferred-width + 14px;
            clicked => {
                root.layout-clicked();
            }
            layout := Label {
                x: 7px;
                height: parent.height;
                text: root.layout-code;
                color: Theme.text;
            }
        }
        // Control Center: two little switches, like macOS.
        Item {
            width: 30px;
            clicked => {
                root.control-center-clicked();
            }
            for i in 2: Rectangle {
                x: 8px;
                y: (parent.height - 14px) / 2 + i * 8px;
                width: 14px;
                height: 6px;
                border-radius: 3px;
                border-width: 1.2px;
                border-color: Theme.text;
                Rectangle {
                    x: i == 0 ? 1.5px : parent.width - 4.5px;
                    y: 1.5px;
                    width: 3px;
                    height: 3px;
                    border-radius: 1.5px;
                    background: Theme.text;
                }
            }
        }
        if root.battery >= 0: Item {
            width: pct.preferred-width + 38px + 20px;
            clicked => {
                root.battery-clicked();
            }
            pct := Label {
                x: 8px;
                height: parent.height;
                text: (root.charging ? "+" : "") + root.battery + "%";
            }
            Battery {
                x: pct.x + pct.preferred-width + 6px;
                y: (parent.height - self.height) / 2;
                percent: root.battery;
                charging: root.charging;
            }
        }
        Item {
            width: date.preferred-width + root.clock-width + 30px + (root.meridiem != "" ? ampm.preferred-width + 5px : 0px);
            clicked => {
                root.clock-clicked();
            }
            date := Label {
                x: 8px;
                height: parent.height;
                text: root.date;
                color: Theme.text;
            }
            Dot {
                size: 3px;
                x: date.x + date.preferred-width + 5px;
                y: (parent.height - 3px) / 2;
                background: Theme.accent;
            }
            Image {
                x: date.x + date.preferred-width + 14px;
                y: (parent.height - self.height) / 2;
                width: root.clock-width;
                height: root.clock-height;
                source: root.clock-dots;
                colorize: Theme.text;
            }
            ampm := Label {
                x: date.x + date.preferred-width + 14px + root.clock-width + 5px;
                height: parent.height;
                text: root.meridiem;
                font-size: 10px;
            }
        }
    }
}
