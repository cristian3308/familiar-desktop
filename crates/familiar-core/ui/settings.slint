import { Theme } from "theme.slint";

// macOS-style controls, drawn by hand so they match the rest of the shell.

// One palette in the theme picker, shown as a paint-chip card.
export struct ThemeCard {
    name: string,
    code: string,
    bg: color,
    accent: color,
    ink: color,
}

component Switch inherits Rectangle {
    in-out property <bool> on;
    callback toggled();
    width: 40px;
    height: 24px;
    border-radius: 12px;
    background: root.on ? #30d158 : #ffffff26;
    animate background { duration: 160ms; }
    Rectangle {
        x: root.on ? root.width - self.width - 2px : 2px;
        y: 2px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: white;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000059;
        animate x { duration: 180ms; easing: cubic-bezier(0.3, 1.3, 0.5, 1); }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.on = !root.on;
            root.toggled();
        }
    }
}

component Slider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value;
    // Fired when the knob is released, so files are written once per drag.
    callback committed();
    height: 24px;
    property <float> t: (root.value - root.minimum) / (root.maximum - root.minimum);
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: #ffffff26;
        Rectangle {
            x: 0;
            width: parent.width * root.t;
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    Rectangle {
        x: (root.width - self.width) * root.t;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: white;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000066;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        function set(x: length) {
            root.value = root.minimum + clamp(x / root.width, 0, 1) * (root.maximum - root.minimum);
        }
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down {
                self.set(self.mouse-x);
            }
            if ev.kind == PointerEventKind.up {
                root.committed();
            }
        }
        moved => {
            if self.pressed {
                self.set(self.mouse-x);
            }
        }
    }
}

component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> danger;
    callback clicked();
    height: 30px;
    width: label.preferred-width + 28px;
    border-radius: 8px;
    background: root.primary ? (touch.pressed ? Theme.accent.darker(0.2) : Theme.accent) : (touch.has-hover ? #ffffff26 : #ffffff1a);
    animate background { duration: 100ms; }
    label := Text {
        text: root.text;
        color: root.danger ? #ff453a : (root.primary ? Theme.on-accent : white);
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A grouped list like macOS System Settings.
component Group inherits Rectangle {
    background: #ffffff0d;
    border-radius: 12px;
    border-width: 1px;
    border-color: #ffffff12;
    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        @children
    }
}

component Row inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> last;
    min-height: 48px;
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.title;
                color: white;
                font-size: 13px;
            }
            if root.detail != "": Text {
                text: root.detail;
                color: #ffffff80;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            horizontal-stretch: 0;
            alignment: end;
            @children
        }
    }
    if !root.last: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #ffffff12;
    }
}

component SectionTitle inherits Text {
    color: #ffffff80;
    font-size: 11px;
    font-weight: 700;
}

component SidebarItem inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <color> tint;
    in property <bool> selected;
    callback clicked();
    height: 32px;
    border-radius: 7px;
    background: root.selected ? Theme.accent : (touch.has-hover ? #ffffff14 : transparent);
    HorizontalLayout {
        padding-left: 8px;
        spacing: 10px;
        Rectangle {
            y: 5px;
            width: 22px;
            height: 22px;
            border-radius: 6px;
            background: root.tint;
            Text {
                text: root.glyph;
                font-family: Theme.icons;
                font-size: 12px;
                color: white;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.label;
            color: root.selected ? Theme.on-accent : white;
            font-size: 13px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component SettingsWindow inherits Window {
    title: @tr("Ajustes de Familiar");
    no-frame: true;
    background: transparent;
    default-font-family: Theme.font;

    in-out property <int> section;

    in property <[ThemeCard]> themes;
    in-out property <int> theme-index;
    in property <[color]> accents: [#ff2b2b, #ff9f0a, #ffd60a, #30d158, #64d2ff, #0a84ff, #bf5af2, #ff375f, #ffffff];
    in-out property <color> accent;
    in-out property <float> bar-opacity;

    in-out property <float> icon-size;
    in-out property <float> magnification;
    in-out property <bool> custom-icons;
    in-out property <bool> show-running;

    in-out property <bool> w-calendar;
    in-out property <bool> w-weather;
    in-out property <bool> w-system;
    in-out property <bool> w-signal;
    in property <string> signal-mode;
    in-out property <bool> w-clock;
    in-out property <bool> w-visualizer;
    in-out property <bool> w-analog;
    in-out property <bool> w-music;
    in-out property <string> city;

    in-out property <bool> hide-taskbar;
    in-out property <bool> autostart;
    in-out property <bool> lock-on-start;
    in-out property <bool> window-animations;
    in-out property <bool> genie-effect;
    in property <bool> needs-restart;

    // Something editable changed; Rust reads every property and applies.
    callback changed();
    callback theme-chosen(int);
    callback city-committed(string);
    callback signal-mode-next();
    callback files-style-next();
    callback calm-next(int);
    callback language-next();
    in property <[string]> calm-labels: ["", "", "", ""];
    in property <string> language-name;
    callback surprise-me();
    callback theme-from-wallpaper();
    callback transition-next();
    in property <string> transition;
    in-out property <bool> alt-w;
    in property <string> files-style;
    in-out property <bool> window-previews;
    callback restart();
    callback quit-familiar();
    callback close-window();
    callback drag-moved(length, length);

    Rectangle {
        background: #1c1c1ef7;
        border-radius: 14px;
        border-width: 1px;
        border-color: #ffffff26;
        clip: true;

        HorizontalLayout {
            // ---- sidebar ----
            Rectangle {
                width: 210px;
                background: #2c2c2e99;
                VerticalLayout {
                    padding: 12px;
                    padding-top: 14px;
                    spacing: 4px;
                    alignment: start;
                    // Traffic lights; the red one closes.
                    HorizontalLayout {
                        spacing: 8px;
                        height: 22px;
                        alignment: start;
                        for c[i] in [#ff5f57, #febc2e, #28c840]: Rectangle {
                            y: 5px;
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: c;
                            if i == 0: TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.close-window();
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 14px;
                    }
                    SidebarItem {
                        glyph: "\u{E790}";
                        label: @tr("Apariencia");
                        tint: #0a84ff;
                        selected: root.section == 0;
                        clicked => {
                            root.section = 0;
                        }
                    }
                    SidebarItem {
                        glyph: "\u{E7F4}";
                        label: @tr("Dock");
                        tint: #8e8e93;
                        selected: root.section == 1;
                        clicked => {
                            root.section = 1;
                        }
                    }
                    SidebarItem {
                        glyph: "\u{E8FD}";
                        label: @tr("Widgets");
                        tint: #bf5af2;
                        selected: root.section == 2;
                        clicked => {
                            root.section = 2;
                        }
                    }
                    SidebarItem {
                        glyph: "\u{E713}";
                        label: @tr("General");
                        tint: #636366;
                        selected: root.section == 3;
                        clicked => {
                            root.section = 3;
                        }
                    }
                    SidebarItem {
                        glyph: "\u{E708}";
                        label: @tr("Calma e idioma");
                        tint: #5e5ce6;
                        selected: root.section == 4;
                        clicked => {
                            root.section = 4;
                        }
                    }
                }
            }

            // ---- content ----
            VerticalLayout {
                padding: 22px;
                padding-top: 16px;
                spacing: 14px;
                alignment: start;

                Text {
                    text: root.section == 0 ? @tr("Apariencia") : root.section == 1 ? @tr("Dock") : root.section == 2 ? @tr("Widgets") : root.section == 3 ? @tr("General") : @tr("Calma e idioma");
                    color: white;
                    font-family: Theme.display;
                    font-size: 20px;
                    font-weight: 700;
                }

                if root.section == 0: VerticalLayout {
                    spacing: 8px;
                    SectionTitle {
                        text: @tr("TEMA");
                    }
                    // Paint-chip cards, six per row; scrolls past three rows.
                    grid := Flickable {
                        property <length> card-w: (self.width - 5 * 8px) / 6;
                        height: min(3, ceil(root.themes.length / 6)) * 86px;
                        content-height: ceil(root.themes.length / 6) * 86px;
                        for t[i] in root.themes: Rectangle {
                            property <bool> chosen: i == root.theme-index;
                            x: mod(i, 6) * (grid.card-w + 8px);
                            y: floor(i / 6) * 86px + (chosen ? 0px : 3px);
                            width: grid.card-w;
                            height: 78px;
                            border-radius: 12px;
                            background: #f5f5f0;
                            border-width: chosen ? 2px : 1px;
                            border-color: chosen ? Theme.accent : #ffffff26;
                            clip: true;
                            animate y { duration: 160ms; easing: ease-out; }
                            // Colour swatch.
                            Rectangle {
                                y: 0;
                                height: 44px;
                                background: t.bg;
                                Rectangle {
                                    x: parent.width - 20px;
                                    y: 10px;
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 5px;
                                    background: t.accent;
                                }
                                Text {
                                    x: 8px;
                                    y: 20px;
                                    text: @tr("Aa");
                                    color: t.ink;
                                    font-family: Theme.display;
                                    font-size: 16px;
                                    font-weight: 700;
                                }
                            }
                            Text {
                                x: 8px;
                                y: 47px;
                                text: t.name;
                                color: #1c1c1e;
                                font-size: 11px;
                                font-weight: 700;
                                overflow: elide;
                                width: parent.width - 16px;
                            }
                            Text {
                                x: 8px;
                                y: 62px;
                                text: t.code;
                                color: #8e8e93;
                                font-family: Theme.mono;
                                font-size: 9px;
                                letter-spacing: 1px;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.theme-index = i;
                                    root.theme-chosen(i);
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Button {
                            text: @tr("Surprise me");
                            primary: true;
                            clicked => {
                                root.surprise-me();
                            }
                        }
                        Button {
                            text: @tr("Tema desde el fondo");
                            clicked => {
                                root.theme-from-wallpaper();
                            }
                        }
                    }
                    SectionTitle {
                        text: @tr("COLOR DE ACENTO");
                    }
                    Group {
                        Rectangle {
                            height: 56px;
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                for c in root.accents: Rectangle {
                                    y: 16px;
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 12px;
                                    background: c;
                                    border-width: root.accent == c ? 3px : 0px;
                                    border-color: #ffffffcc;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.accent = c;
                                            root.changed();
                                        }
                                    }
                                }
                            }
                        }
                    }
                    SectionTitle {
                        text: @tr("BARRA SUPERIOR");
                    }
                    Group {
                        Row {
                            title: @tr("Opacidad");
                            detail: round(root.bar-opacity * 100) + " %";
                            last: true;
                            Slider {
                                width: 220px;
                                minimum: 0;
                                maximum: 1;
                                value <=> root.bar-opacity;
                                committed => {
                                    root.changed();
                                }
                            }
                        }
                    }
                }

                if root.section == 1: VerticalLayout {
                    spacing: 8px;
                    Group {
                        Row {
                            title: @tr("Tamaño de los iconos");
                            detail: round(root.icon-size) + @tr(" px");
                            Slider {
                                width: 220px;
                                minimum: 32;
                                maximum: 72;
                                value <=> root.icon-size;
                                committed => {
                                    root.changed();
                                }
                            }
                        }
                        Row {
                            title: @tr("Ampliación");
                            detail: round(root.magnification * 100) / 100 + "×";
                            Slider {
                                width: 220px;
                                minimum: 1;
                                maximum: 2;
                                value <=> root.magnification;
                                committed => {
                                    root.changed();
                                }
                            }
                        }
                        Row {
                            title: @tr("Iconos estilo macOS");
                            detail: @tr("Explorador, Configuración y Terminal");
                            Switch {
                                y: 12px;
                                on <=> root.custom-icons;
                                toggled => {
                                    root.changed();
                                }
                            }
                        }
                        Row {
                            title: @tr("Icono de Archivos");
                            detail: @tr("Classic, Dot F, Mono, Theme o Glass");
                            Button {
                                y: 9px;
                                text: root.files-style;
                                clicked => {
                                    root.files-style-next();
                                }
                            }
                        }
                        Row {
                            title: @tr("Ventanas al pasar el ratón");
                            detail: @tr("Lista las ventanas abiertas de la app");
                            Switch {
                                y: 12px;
                                on <=> root.window-previews;
                                toggled => {
                                    root.changed();
                                }
                            }
                        }
                        Row {
                            title: @tr("Mostrar apps abiertas");
                            last: true;
                            Switch {
                                y: 12px;
                                on <=> root.show-running;
                                toggled => {
                                    root.changed();
                                }
                            }
                        }
                    }
                }

                if root.section == 2: VerticalLayout {
                    spacing: 8px;
                    Group {
                        Row {
                            title: @tr("Calendario");
                            Switch {
                                y: 12px;
                                on <=> root.w-calendar;
                                toggled => {
                                    root.changed();
                                }
                            }
                        }
                        Row {
                            title: @tr("Clima");
                            detail: @tr("Usa internet (Open-Meteo)");
                            Switch {
                                y: 12px;
                                on <=> root.w-weather;
                                toggled => {
                                    root.changed();
                                }
                            }
                        }
                        Row {
                            title: @tr("Sistema");
                            detail: @tr("CPU, memoria y batería");
                            Switch {
                                y: 12px;
                                on <=> root.w-system;
                                toggled => {
                                    root.changed();
                                }
                            }
                        }
                        Row {
                            title: @tr("SIGNAL/01");
                            detail: @tr("Matriz de puntos: pulsa el modo para cambiarlo");
                            Button {
                                y: 9px;
                                text: root.signal-mode;
                                clicked => {
                                    root.signal-mode-next();
                                }
                            }
                            Switch {
                                y: 12px;
                                on <=> root.w-signal;
                                toggled => {
                                    root.changed();
                                }
                            }
                        }
                        Row {
                            title: @tr("Reloj de puntos");
                            Switch {
                                y: 12px;
                                on <=> root.w-clock;
                                toggled => {
                                    root.changed();
                                }
                            }
                        }
                        Row {
                            title: @tr("Visualizador");
                            detail: @tr("Seis escenas; toca el widget para cambiar");
                            Switch {
                                y: 12px;
                                on <=> root.w-visualizer;
                                toggled => {
                                    root.changed();
                                }
                            }
                        }
                        Row {
                            title: @tr("Reloj analógico");
                            Switch {
                                y: 12px;
                                on <=> root.w-analog;
                                toggled => {
                                    root.changed();
                                }
                            }
                        }
                        Row {
                            title: @tr("Música");
                            detail: @tr("Carátula y controles");
                            last: true;
                            Switch {
                                y: 12px;
                                on <=> root.w-music;
                                toggled => {
                                    root.changed();
                                }
                            }
                        }
                    }
                    SectionTitle {
                        text: @tr("CIUDAD DEL CLIMA");
                    }
                    Rectangle {
                        height: 36px;
                        border-radius: 8px;
                        background: #ffffff14;
                        border-width: 1px;
                        border-color: city-input.has-focus ? Theme.accent : #ffffff1a;
                        city-input := TextInput {
                            x: 12px;
                            width: parent.width - 24px;
                            text <=> root.city;
                            color: white;
                            font-size: 13px;
                            vertical-alignment: center;
                            single-line: true;
                            accepted => {
                                root.city-committed(self.text);
                            }
                        }
                    }
                    Text {
                        text: @tr("Pulsa Intro para guardar la ciudad.");
                        color: #ffffff66;
                        font-size: 11px;
                    }
                }

                if root.section == 4: VerticalLayout {
                    spacing: 8px;
                    SectionTitle {
                        text: @tr("CALM BY DESIGN");
                    }
                    Group {
                        for scenario[i] in [
                            @tr("Ventana en primer plano"),
                            @tr("Ventana maximizada"),
                            @tr("Pantalla completa o juego"),
                            @tr("Portátil con batería")]: Row {
                            title: scenario;
                            last: i == 3;
                            Button {
                                y: 9px;
                                text: root.calm-labels[i];
                                clicked => {
                                    root.calm-next(i);
                                }
                            }
                        }
                    }
                    Text {
                        text: @tr("Se aplica la regla más estricta de las situaciones activas.");
                        color: #ffffff66;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    SectionTitle {
                        text: @tr("IDIOMA");
                    }
                    Group {
                        Row {
                            title: @tr("Idioma de la interfaz");
                            detail: @tr("También desde la barra superior");
                            last: true;
                            Button {
                                y: 9px;
                                text: root.language-name;
                                clicked => {
                                    root.language-next();
                                }
                            }
                        }
                    }
                }

                if root.section == 3: VerticalLayout {
                    spacing: 8px;
                    Group {
                        Row {
                            title: @tr("Ocultar la barra de tareas de Windows");
                            Switch {
                                y: 12px;
                                on <=> root.hide-taskbar;
                                toggled => {
                                    root.changed();
                                }
                            }
                        }
                        Row {
                            title: @tr("Animación al abrir y minimizar");
                            detail: @tr("Las ventanas salen del Dock y vuelven a él");
                            Switch {
                                y: 12px;
                                on <=> root.window-animations;
                                toggled => {
                                    root.changed();
                                }
                            }
                        }
                        Row {
                            title: @tr("Efecto genio al minimizar");
                            detail: @tr("Apagado: la ventana se encoge suavemente");
                            Switch {
                                y: 12px;
                                on <=> root.genie-effect;
                                toggled => {
                                    root.changed();
                                }
                            }
                        }
                        Row {
                            title: @tr("Pantalla de bienvenida al iniciar");
                            detail: @tr("Splash y pantalla de bloqueo (solo visual)");
                            Switch {
                                y: 12px;
                                on <=> root.lock-on-start;
                                toggled => {
                                    root.changed();
                                }
                            }
                        }
                        Row {
                            title: @tr("Alt + W cambia el fondo");
                            detail: @tr("Recorre la carpeta del fondo actual (al reiniciar)");
                            Button {
                                y: 9px;
                                text: root.transition;
                                clicked => {
                                    root.transition-next();
                                }
                            }
                            Switch {
                                y: 12px;
                                on <=> root.alt-w;
                                toggled => {
                                    root.changed();
                                }
                            }
                        }
                        Row {
                            title: @tr("Abrir al iniciar Windows");
                            last: true;
                            Switch {
                                y: 12px;
                                on <=> root.autostart;
                                toggled => {
                                    root.changed();
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Button {
                            text: @tr("Reiniciar Familiar");
                            clicked => {
                                root.restart();
                            }
                        }
                        Button {
                            text: @tr("Salir de Familiar");
                            danger: true;
                            clicked => {
                                root.quit-familiar();
                            }
                        }
                    }
                }
            }
        }

        if root.needs-restart: Rectangle {
            x: 210px + 22px;
            y: parent.height - self.height - 18px;
            width: parent.width - 210px - 44px;
            height: 48px;
            border-radius: 12px;
            background: Theme.accent.with-alpha(0.18);
            border-width: 1px;
            border-color: Theme.accent.with-alpha(0.5);
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 9px;
                spacing: 10px;
                Text {
                    text: @tr("Algunos cambios se aplican al reiniciar.");
                    color: white;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                Button {
                    y: 9px;
                    text: @tr("Reiniciar ahora");
                    primary: true;
                    clicked => {
                        root.restart();
                    }
                }
            }
        }
    }

    // Drag the window by its top strip (right of the traffic lights).
    TouchArea {
        x: 80px;
        width: parent.width - 80px;
        height: 44px;
        moved => {
            root.drag-moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
        }
    }
}
