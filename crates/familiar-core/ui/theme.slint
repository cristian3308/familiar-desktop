// Values are pushed from Rust whenever the TOML theme changes (hot reload).
export global Theme {
    in-out property <color> tint: #121214cc;
    in-out property <color> accent: #ff6b4a;
    in-out property <color> text: #f5f5f7;
    in-out property <color> text-secondary: #a1a1a6;
    in-out property <color> glow: #ffffff22;
    in-out property <color> island: #000000f2;
    in-out property <length> radius: 18px;
    in-out property <length> bar-height: 32px;
    out property <string> font: "Segoe UI Variable Text";
    out property <string> icons: "Segoe Fluent Icons";
}
