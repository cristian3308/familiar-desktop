import { Theme, Label, Dot } from "theme.slint";

component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <length> size: 16px;
    // The primary button is a solid white disc with a black glyph.
    in property <bool> primary;
    callback clicked();
    width: root.primary ? 46px : 38px;
    height: self.width;
    border-radius: self.width / 2;
    border-width: root.primary ? 0px : 1px;
    border-color: touch.has-hover ? #ffffff66 : #ffffff26;
    background: root.primary ? (touch.pressed ? #d0d0d0 : white) : (touch.has-hover ? #ffffff14 : transparent);
    animate background, border-color { duration: 120ms; }
    Text {
        text: root.glyph;
        font-family: Theme.icons;
        font-size: root.size;
        color: root.primary ? black : white;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Seek bar: drag (or click) to scrub; the seek is sent on release.
component Scrubber inherits Rectangle {
    in property <float> progress;
    callback seek(float);
    property <bool> dragging;
    property <float> drag-value;
    property <float> shown: root.dragging ? root.drag-value : root.progress;
    property <bool> active: touch.has-hover || root.dragging;
    height: 16px;
    track := Rectangle {
        y: (parent.height - self.height) / 2;
        height: root.active ? 6px : 4px;
        border-radius: self.height / 2;
        background: #ffffff26;
        animate height { duration: 120ms; }
        Rectangle {
            x: 0;
            width: parent.width * max(0, min(1, root.shown));
            height: parent.height;
            border-radius: parent.border-radius;
            background: root.active ? Theme.accent : #ffffffd9;
        }
    }
    if root.active: Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: white;
        x: root.width * max(0, min(1, root.shown)) - 6px;
        y: (root.height - 12px) / 2;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                root.dragging = true;
                root.drag-value = max(0, min(1, self.mouse-x / self.width));
            }
            if ev.kind == PointerEventKind.up && root.dragging {
                root.dragging = false;
                root.seek(root.drag-value);
            }
        }
        moved => {
            if root.dragging {
                root.drag-value = max(0, min(1, self.mouse-x / self.width));
            }
        }
    }
}

export component IslandWindow inherits Window {
    title: "Familiar Island";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: Theme.font;

    in property <bool> expanded;
    in property <bool> has-media;
    in property <bool> playing;
    in property <string> track;
    in property <string> artist;
    in property <image> artwork;
    in property <bool> has-artwork;
    in property <image> spectrum;
    in property <bool> mic;
    in property <bool> cam;
    in property <length> collapsed-width: 200px;
    in property <length> collapsed-height: 28px;
    in property <length> expanded-width: 400px;
    in property <length> expanded-height: 176px;
    // Playback timeline.
    in property <bool> has-timeline;
    in property <float> progress;
    in property <string> elapsed-text;
    in property <string> total-text;
    // Temporary alert pill (device connected, focus finished...).
    in property <string> alert-text;
    in property <string> alert-glyph;
    // Focus (Pomodoro) timer.
    in property <bool> focus-active;
    in property <string> focus-text: "25:00";

    callback hover-changed(bool);
    callback play-pause();
    callback next();
    callback previous();
    callback open-source();
    callback seek(float);
    callback focus-toggle();

    pill := Rectangle {
        width: root.expanded ? root.expanded-width : root.collapsed-width;
        height: root.expanded ? root.expanded-height : root.collapsed-height;
        x: (root.width - self.width) / 2;
        y: 0;
        border-radius: root.expanded ? 34px : self.height / 2;
        background: Theme.island;
        border-width: 1px;
        border-color: root.expanded ? #ffffff1f : #ffffff10;
        clip: true;
        // Springy, slightly overshooting curve like the iPhone island.
        animate width, height, border-radius {
            duration: 420ms;
            easing: cubic-bezier(0.2, 1.25, 0.32, 1);
        }

        // Wraps the content: children (the transport buttons) get clicks
        // first, while this keeps reporting hover for the whole pill.
        hover := TouchArea {
            changed has-hover => {
                root.hover-changed(self.has-hover);
            }

            // Collapsed alert: icon and a short message.
            HorizontalLayout {
                opacity: !root.expanded && root.alert-text != "" ? 1 : 0;
                animate opacity { duration: 160ms; }
                padding-left: 12px;
                padding-right: 14px;
                spacing: 8px;
                alignment: center;
                Text {
                    text: root.alert-glyph;
                    font-family: Theme.icons;
                    font-size: 13px;
                    color: Theme.accent;
                    vertical-alignment: center;
                }
                Text {
                    text: root.alert-text;
                    color: white;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // Collapsed: artwork chip on the left, live dot bars on the right.
            HorizontalLayout {
                opacity: root.expanded || root.alert-text != "" ? 0 : 1;
                animate opacity { duration: 120ms; }
                padding-left: 5px;
                padding-right: 12px;
                spacing: 8px;
                alignment: space-between;
                if root.has-media: Rectangle {
                    width: root.collapsed-height - 8px;
                    height: root.collapsed-height - 8px;
                    y: 4px;
                    border-radius: self.height / 2;
                    clip: true;
                    background: #ffffff1a;
                    if root.has-artwork: Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.artwork;
                        image-fit: cover;
                    }
                }
                // Idle: three quiet dots, the centre one red.
                if !root.has-media: HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    horizontal-stretch: 1;
                    for i in 3: Dot {
                        size: 4px;
                        y: (root.collapsed-height - 4px) / 2;
                        background: i == 1 ? Theme.accent : #ffffff59;
                    }
                }
                if root.focus-active: Text {
                    text: root.focus-text;
                    color: Theme.accent;
                    font-family: Theme.display;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                if root.mic || root.cam: Dot {
                    size: 6px;
                    y: (root.collapsed-height - 6px) / 2;
                    background: root.cam ? #30d158 : Theme.accent;
                }
                if root.has-media: Image {
                    width: 46px;
                    height: root.collapsed-height - 12px;
                    y: 6px;
                    source: root.spectrum;
                    image-fit: fill;
                    colorize: root.playing ? Theme.accent : #ffffff59;
                }
            }

            // Expanded: now playing card.
            VerticalLayout {
                opacity: root.expanded ? 1 : 0;
                animate opacity { duration: 220ms; delay: 120ms; }
                padding: 18px;
                padding-top: 14px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 7px;
                    height: 14px;
                    Dot {
                        size: 6px;
                        y: 4px;
                        background: root.playing ? Theme.accent : #ffffff59;
                    }
                    Label {
                        text: root.playing ? "REPRODUCIENDO" : (root.has-media ? "EN PAUSA" : "SIN MÚSICA");
                        font-size: 10px;
                        color: #ffffffa6;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    // Focus chip: starts / stops a Pomodoro.
                    Rectangle {
                        width: focus-label.preferred-width + 16px;
                        height: 18px;
                        y: -2px;
                        border-radius: 9px;
                        background: root.focus-active ? Theme.accent : (focus-touch.has-hover ? #ffffff26 : #ffffff14);
                        focus-label := Text {
                            text: root.focus-active ? "FOCUS " + root.focus-text : "FOCUS";
                            color: white;
                            font-size: 9px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        focus-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.focus-toggle();
                            }
                        }
                    }
                    Image {
                        width: 54px;
                        height: 14px;
                        source: root.spectrum;
                        image-fit: fill;
                        colorize: Theme.accent;
                    }
                }

                HorizontalLayout {
                    spacing: 14px;
                    Rectangle {
                        width: 60px;
                        height: 60px;
                        border-radius: 14px;
                        clip: true;
                        background: #ffffff14;
                        if root.has-artwork: Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.artwork;
                            image-fit: cover;
                        }
                        if !root.has-artwork: Text {
                            text: "\u{E8D6}";
                            font-family: Theme.icons;
                            font-size: 22px;
                            color: #ffffff80;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.open-source();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        Text {
                            text: root.has-media ? root.track : "Nada reproduciéndose";
                            color: white;
                            font-family: Theme.display;
                            font-size: 16px;
                            font-weight: 700;
                            overflow: elide;
                        }
                        Text {
                            text: root.artist;
                            color: #ffffff8c;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }
                }

                // Timeline: elapsed, seek bar, length.
                HorizontalLayout {
                    spacing: 10px;
                    height: 16px;
                    opacity: root.has-timeline ? 1 : 0.35;
                    Text {
                        text: root.has-timeline ? root.elapsed-text : "--:--";
                        color: #ffffff99;
                        font-size: 10px;
                        vertical-alignment: center;
                        width: 34px;
                    }
                    Scrubber {
                        horizontal-stretch: 1;
                        progress: root.progress;
                        seek(f) => {
                            if root.has-timeline {
                                root.seek(f);
                            }
                        }
                    }
                    Text {
                        text: root.has-timeline ? root.total-text : "--:--";
                        color: #ffffff99;
                        font-size: 10px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        width: 34px;
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 22px;
                    IconButton {
                        y: 4px;
                        glyph: "\u{E892}";
                        clicked => {
                            root.previous();
                        }
                    }
                    IconButton {
                        primary: true;
                        glyph: root.playing ? "\u{E769}" : "\u{E768}";
                        size: 18px;
                        clicked => {
                            root.play-pause();
                        }
                    }
                    IconButton {
                        y: 4px;
                        glyph: "\u{E893}";
                        clicked => {
                            root.next();
                        }
                    }
                }
            }
        }
    }
}
