import { Theme, Label, RoundRect } from "theme.slint";

export struct DockIcon {
    icon: image,
    name: string,
    running: bool,
    active: bool,
    separator: bool,
    // Geometry is computed in Rust (familiar-layout) on every pointer move.
    x: length,
    size: length,
    // Upward offset while the app is launching (the macOS bounce).
    lift: length,
    // 0 = app icon, 1 = launcher tile, 2 = trash, 3 = files (Explorer),
    // 4 = settings, 5 = terminal.
    kind: int,
    // Shown on a fallback tile when the app has no icon.
    initial: string,
}

// macOS-style trash can: lid, translucent ribbed body, soft shadow.
component TrashCan inherits Rectangle {
    // Shadow under the can.
    Rectangle {
        x: parent.width * 0.2;
        y: parent.height * 0.9;
        width: parent.width * 0.6;
        height: parent.height * 0.07;
        border-radius: self.height / 2;
        background: #00000040;
    }
    // Body: a tapering bucket.
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 100;
        viewbox-height: 100;
        fill: @linear-gradient(90deg, #d8d8dc 0%, #ffffff 35%, #f2f2f7 60%, #b9b9bf 100%);
        stroke: #8e8e93;
        stroke-width: 1px;
        commands: "M 17 24 L 83 24 L 76 91 Q 75.5 95 71 95 L 29 95 Q 24.5 95 24 91 Z";
    }
    // Ribs.
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: #8e8e93a6;
        stroke-width: 1px;
        commands: "M 29 30 L 32 89 M 39.5 30 L 41 89 M 50 30 L 50 89 M 60.5 30 L 59 89 M 71 30 L 68 89";
    }
    // Rim.
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 100;
        viewbox-height: 100;
        fill: @linear-gradient(180deg, #ffffff 0%, #d1d1d6 100%);
        stroke: #8e8e93;
        stroke-width: 1px;
        commands: "M 14 19 Q 14 16 17 16 L 83 16 Q 86 16 86 19 L 86 24 Q 86 27 83 27 L 17 27 Q 14 27 14 24 Z";
    }
    // Lid handle.
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 100;
        viewbox-height: 100;
        fill: @linear-gradient(180deg, #f2f2f7 0%, #c7c7cc 100%);
        stroke: #8e8e93;
        stroke-width: 1px;
        commands: "M 40 16 L 40 11 Q 40 8 43 8 L 57 8 Q 60 8 60 11 L 60 16 L 55 16 L 55 12 L 45 12 L 45 16 Z";
    }
}

// Files (Explorer): blue tile with a folder.
// Files (Explorer). `variant`: 0 classic, 1 dot F, 2 mono, 3 theme, 4 glass.
component FilesIcon inherits Rectangle {
    in property <length> size;
    in property <int> variant;
    // 5x7 dot-matrix "F" for the dot variant.
    property <[bool]> f-dots: [
        true, true, true, true, true,
        true, false, false, false, false,
        true, false, false, false, false,
        true, true, true, true, false,
        true, false, false, false, false,
        true, false, false, false, false,
        true, false, false, false, false];
    border-radius: self.size * 0.24;
    clip: true;
    border-width: 1px;
    border-color: root.variant == 4 ? #ffffff73 : #ffffff40;
    // Gradients are drawn as paths (see RoundRect in theme.slint).
    RoundRect {
        width: parent.width;
        height: parent.height;
        radius: root.size * 0.24;
        fill: root.variant == 0 ? @linear-gradient(180deg, #6fd3ff 0%, #1a8cff 100%)
            : root.variant == 1 ? @linear-gradient(160deg, #2a2a2a 0%, #050505 100%)
            : root.variant == 2 ? @linear-gradient(180deg, #3a3a3c 0%, #1c1c1e 100%)
            : root.variant == 3 ? @linear-gradient(180deg, Theme.accent.brighter(0.25) 0%, Theme.accent 100%)
            : @linear-gradient(180deg, #ffffff59 0%, #ffffff1a 100%);
    }
    // Folder for every variant except the dot "F".
    if root.variant != 1: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 100;
        viewbox-height: 100;
        fill: root.variant == 0 ? #0b5fd6 : root.variant == 2 ? transparent : #ffffff8c;
        stroke: root.variant == 2 ? #ffffffd9 : transparent;
        stroke-width: root.variant == 2 ? 2.4px : 0px;
        commands: "M 18 30 Q 18 25 23 25 L 42 25 L 48 31 L 77 31 Q 82 31 82 36 L 82 44 L 18 44 Z";
    }
    if root.variant != 1: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 100;
        viewbox-height: 100;
        fill: root.variant == 0 ? @linear-gradient(180deg, #ffffff 0%, #dceeff 100%) : root.variant == 2 ? transparent : #ffffff;
        stroke: root.variant == 2 ? #ffffffd9 : transparent;
        stroke-width: root.variant == 2 ? 2.4px : 0px;
        commands: "M 18 40 Q 18 36 23 36 L 77 36 Q 82 36 82 41 L 82 72 Q 82 77 77 77 L 23 77 Q 18 77 18 72 Z";
    }
    if root.variant != 1: Rectangle {
        x: parent.width * 0.32;
        y: parent.height * 0.52;
        width: parent.width * 0.36;
        height: max(1px, parent.height * 0.05);
        border-radius: self.height / 2;
        background: root.variant == 0 ? #1a8cff : root.variant == 2 ? #ffffffd9 : root.variant == 3 ? Theme.accent : #ffffff80;
    }
    // Dot-matrix F, Nothing style, with a red accent dot.
    if root.variant == 1: Rectangle {
        property <length> step: root.size * 0.105;
        property <length> dot: self.step * 0.7;
        for d in 35: Rectangle {
            visible: root.f-dots[d];
            x: (root.width - 4 * parent.step - parent.dot) / 2 + mod(d, 5) * parent.step;
            y: (root.height - 6 * parent.step - parent.dot) / 2 + floor(d / 5) * parent.step;
            width: parent.dot;
            height: parent.dot;
            border-radius: parent.dot / 2;
            background: d == 0 ? Theme.accent : white;
        }
    }
}

// Settings: graphite tile with a gear.
component SettingsIcon inherits Rectangle {
    in property <length> size;
    border-radius: self.size * 0.24;
    clip: true;
    border-width: 1px;
    border-color: #ffffff59;
    RoundRect {
        width: parent.width;
        height: parent.height;
        radius: root.size * 0.24;
        fill: @linear-gradient(180deg, #e5e5ea 0%, #8e8e93 100%);
    }
    Rectangle {
        width: parent.width * 0.78;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        clip: true;
        border-width: 1px;
        border-color: #00000059;
        RoundRect {
            width: parent.width;
            height: parent.height;
            radius: parent.width / 2;
            fill: @linear-gradient(180deg, #48484a 0%, #1c1c1e 100%);
        }
    }
    Text {
        text: "\u{E713}";
        font-family: Theme.icons;
        font-size: parent.size * 0.56;
        color: #d1d1d6;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Terminal: black window with traffic lights and a prompt.
component TerminalIcon inherits Rectangle {
    in property <length> size;
    border-radius: self.size * 0.24;
    clip: true;
    border-width: 1px;
    border-color: #ffffff26;
    RoundRect {
        width: parent.width;
        height: parent.height;
        radius: root.size * 0.24;
        fill: @linear-gradient(180deg, #2c2c2e 0%, #000000 100%);
    }
    for c[i] in [#ff5f57, #febc2e, #28c840]: Rectangle {
        x: parent.width * (0.16 + 0.12 * i);
        y: parent.height * 0.14;
        width: parent.width * 0.08;
        height: self.width;
        border-radius: self.width / 2;
        background: c;
    }
    Text {
        x: parent.width * 0.16;
        y: parent.height * 0.36;
        text: ">_";
        font-family: Theme.mono;
        font-size: parent.size * 0.34;
        font-weight: 700;
        color: #32d74b;
    }
}

// A built-in tile drawn like an app icon (rounded square).
component Tile inherits Rectangle {
    in property <length> size;
    in property <brush> fill;
    border-radius: self.size * 0.24;
    border-width: 1px;
    border-color: #ffffff2e;
    clip: true;
    RoundRect {
        width: parent.width;
        height: parent.height;
        radius: root.size * 0.24;
        fill: root.fill;
    }
    @children
}

export component DockWindow inherits Window {
    title: "Familiar Dock";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: Theme.font;

    in property <[DockIcon]> icons;
    in property <length> plate-x;
    in property <length> plate-width;
    in property <length> plate-height: 64px;
    in property <length> bottom-margin: 6px;
    in property <length> icon-padding: 8px;
    in property <int> hovered: -1;
    // Icon being dragged to a new place (-1 = none).
    in property <int> drag-index: -1;
    in property <int> files-style;
    // Window list shown above a running app (-1 = hidden).
    in property <int> preview-index: -1;
    in property <[string]> preview-titles;
    in property <int> preview-active: -1;

    callback pointer-moved(length);
    callback hover-changed(bool);
    callback clicked(length);
    callback right-clicked(length);
    callback middle-clicked(length);
    callback drag-started(length);
    callback drag-moved(length);
    callback drag-ended();
    callback preview-clicked(int);
    callback preview-hover(bool);

    property <length> press-x;
    property <bool> dragging;
    // Set when a drag ends so the release is not also taken as a click.
    property <bool> drag-done;

    property <length> plate-y: root.height - root.bottom-margin - root.plate-height;
    property <length> icons-bottom: root.plate-y + root.plate-height - root.icon-padding;
    property <bool> tip-valid: root.hovered >= 0 && root.hovered < root.icons.length && !root.icons[root.hovered].separator;

    // Measured here so Rust can include the tooltip in the window region.
    tip-measure := Label {
        text: root.icons[max(0, root.hovered)].name.to-uppercase();
        visible: false;
    }
    out property <length> tip-width: tip-measure.preferred-width + 34px;
    out property <length> tip-height: 26px;
    property <bool> pressed: touch.pressed;

    Rectangle {
        x: root.plate-x;
        y: root.plate-y;
        width: root.plate-width;
        height: root.plate-height;
        background: Theme.tint;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.glow;
        // Inner hairline highlight along the top edge, like glass.
        Rectangle {
            x: Theme.radius;
            y: 1px;
            width: parent.width - 2 * Theme.radius;
            height: 1px;
            background: @linear-gradient(90deg, transparent 0%, Theme.text.with-alpha(0.22) 50%, transparent 100%);
        }
    }

    for item[i] in root.icons: Rectangle {
        x: item.x;
        y: root.icons-bottom - item.size - item.lift - (i == root.drag-index ? 10px : 0px);
        opacity: i == root.drag-index ? 0.85 : 1;
        width: item.size;
        height: item.size;

        if item.separator: Rectangle {
            x: (parent.width - 1px) / 2;
            y: parent.height * 0.15;
            width: 1px;
            height: parent.height * 0.7;
            background: Theme.glow;
        }
        if !item.separator && item.kind == 0: Image {
            width: parent.width;
            height: parent.height;
            source: item.icon;
            image-fit: contain;
            // Press feedback: the icon dims under the pointer, like macOS.
            opacity: root.pressed && i == root.hovered ? 0.55 : 1;
            animate opacity { duration: 90ms; }
        }
        // Fallback for apps whose icon could not be extracted.
        if !item.separator && item.kind == 0 && item.icon.width == 0: Tile {
            size: parent.width;
            fill: @linear-gradient(160deg, #3a3a3c 0%, #1c1c1e 100%);
            opacity: root.pressed && i == root.hovered ? 0.55 : 1;
            Text {
                text: item.initial;
                font-family: Theme.display;
                font-size: parent.size * 0.5;
                font-weight: 700;
                color: white;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        // Launcher tile: the 3×3 dot mark on black.
        if item.kind == 1: Tile {
            size: parent.width;
            fill: @linear-gradient(160deg, #2a2a2a 0%, #050505 100%);
            opacity: root.pressed && i == root.hovered ? 0.55 : 1;
            for d in 9: Rectangle {
                property <length> dot: parent.size * 0.12;
                property <length> step: parent.size * 0.2;
                x: (parent.width - 2 * self.step - self.dot) / 2 + mod(d, 3) * self.step;
                y: (parent.height - 2 * self.step - self.dot) / 2 + floor(d / 3) * self.step;
                width: self.dot;
                height: self.dot;
                border-radius: self.dot / 2;
                background: d == 4 ? Theme.accent : white;
            }
        }
        // Trash.
        if item.kind == 2: TrashCan {
            width: parent.width;
            height: parent.height;
            opacity: root.pressed && i == root.hovered ? 0.55 : 1;
        }
        // macOS-style icons for Windows' own apps.
        if item.kind == 3: FilesIcon {
            size: parent.width;
            variant: root.files-style;
            opacity: root.pressed && i == root.hovered ? 0.55 : 1;
        }
        if item.kind == 4: SettingsIcon {
            size: parent.width;
            opacity: root.pressed && i == root.hovered ? 0.55 : 1;
        }
        if item.kind == 5: TerminalIcon {
            size: parent.width;
            opacity: root.pressed && i == root.hovered ? 0.55 : 1;
        }
        // Running indicator; it stays on the plate while the icon bounces.
        if item.running && !item.separator: Rectangle {
            width: item.active ? 10px : 4px;
            height: 4px;
            x: (parent.width - self.width) / 2;
            y: parent.height + item.lift + 1px;
            border-radius: 2px;
            background: item.active ? Theme.accent : Theme.text.with-alpha(0.7);
            animate width { duration: 180ms; easing: ease-out; }
        }
    }

    if root.tip-valid: Rectangle {
        property <DockIcon> item: root.icons[root.hovered];
        width: root.tip-width;
        height: root.tip-height;
        x: max(2px, min(root.width - self.width - 2px, item.x + item.size / 2 - self.width / 2));
        y: max(0px, root.icons-bottom - item.size - self.height - 8px);
        border-radius: self.height / 2;
        background: Theme.island;
        border-width: 1px;
        border-color: #ffffff26;
        Rectangle {
            x: 11px;
            y: (parent.height - 5px) / 2;
            width: 5px;
            height: 5px;
            border-radius: 2.5px;
            background: Theme.accent;
        }
        Label {
            x: 22px;
            height: parent.height;
            text: item.name.to-uppercase();
            color: white;
        }
    }

    touch := TouchArea {
        changed mouse-x => {
            root.pointer-moved(self.mouse-x);
            if self.pressed && !root.dragging && abs(self.mouse-x - root.press-x) > 8px {
                root.dragging = true;
                root.drag-started(root.press-x);
            }
            if root.dragging {
                root.drag-moved(self.mouse-x);
            }
        }
        changed has-hover => {
            root.hover-changed(self.has-hover);
            // Leaving the dock mid-drag (or a lost release) ends the drag.
            if !self.has-hover && root.dragging {
                root.dragging = false;
                root.drag-done = true;
                root.drag-ended();
            }
        }
        clicked => {
            if !root.drag-done {
                root.clicked(self.mouse-x);
            }
        }
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                root.press-x = self.mouse-x;
                root.dragging = false;
                root.drag-done = false;
            }
            if ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left && root.dragging {
                root.dragging = false;
                root.drag-done = true;
                root.drag-ended();
            }
            if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right {
                root.right-clicked(self.mouse-x);
            }
            if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.middle {
                root.middle-clicked(self.mouse-x);
            }
        }
    }

    // Open windows of the hovered app; click one to switch to it.
    if root.preview-index >= 0 && root.preview-index < root.icons.length: Rectangle {
        property <DockIcon> item: root.icons[root.preview-index];
        property <length> row-h: 30px;
        width: 260px;
        height: root.preview-titles.length * self.row-h + 34px;
        x: max(2px, min(root.width - self.width - 2px, item.x + item.size / 2 - self.width / 2));
        y: root.icons-bottom - item.size - self.height - 12px;
        border-radius: 16px;
        background: Theme.island;
        border-width: 1px;
        border-color: #ffffff26;
        preview-touch := TouchArea {
            changed has-hover => {
                root.preview-hover(self.has-hover);
            }
        }
        Label {
            x: 14px;
            y: 9px;
            height: 14px;
            text: item.name.to-uppercase() + " · " + root.preview-titles.length + (root.preview-titles.length == 1 ? @tr(" VENTANA") : @tr(" VENTANAS"));
            color: #ffffff99;
            font-size: 9px;
        }
        for title[w] in root.preview-titles: Rectangle {
            x: 6px;
            y: 28px + w * parent.row-h;
            width: parent.width - 12px;
            height: parent.row-h - 2px;
            border-radius: 10px;
            background: row-touch.has-hover ? #ffffff1f : (w == root.preview-active ? #ffffff12 : transparent);
            Rectangle {
                x: 9px;
                y: (parent.height - 6px) / 2;
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: w == root.preview-active ? Theme.accent : #ffffff59;
            }
            Text {
                x: 24px;
                width: parent.width - 32px;
                height: parent.height;
                text: title;
                color: white;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            row-touch := TouchArea {
                mouse-cursor: pointer;
                changed has-hover => {
                    if self.has-hover {
                        root.preview-hover(true);
                    }
                }
                clicked => {
                    root.preview-clicked(w);
                }
            }
        }
    }
}
